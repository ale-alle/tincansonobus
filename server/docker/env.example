# Copy to .env next to compose.yaml. configure.sh fills in the blanks it can (public IP, LiveKit
# key and secret, room seed) and keeps them on later runs. Keep .env private (chmod 600).

RTC_DOMAIN=rtc.tincanstudios.ca     # LiveKit signalling (wss://) and the audio server's name
TURN_DOMAIN=turn.tincanstudios.ca   # LiveKit TURN over TLS, shares port 443
PUBLIC_IP=                          # empty: detected by configure.sh
AOO_PORT=10998
RELAY_PORT_FIRST=40000
RELAY_PORT_LAST=40999

# Pinned images. CANDUET_SERVER_IMAGE: a :<commit> tag that CI published from main
# (.github/workflows/canduet-server-image.yml); change it on purpose to update or roll back.
# Third-party images are version tags; add @sha256:<digest> to pin them exactly.
CANDUET_SERVER_IMAGE=ghcr.io/ale-alle/canduet-server:REPLACE_WITH_COMMIT
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.9
CADDY_IMAGE=livekit/caddyl4:v2.11.3
PYTHON_IMAGE=python:3.12-slim

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Test join service only (profile test-api): TEST_API=1 opens https://<RTC_DOMAIN>:8443
TEST_API=0
MOCK_TICKETS=                       # <ticket>=<name>,<ticket>=<name>
MOCK_ROOM_SEED=
